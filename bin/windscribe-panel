#!/usr/bin/env python3
"""Windscribe for the desktop bar: the one program every front end runs.

For a bar (Waybar or any bar that takes a JSON custom module):

    windscribe-panel waybar     status, icon state and tooltip as one JSON line
    windscribe-panel menu       pick a location, fastest first, in your launcher
    windscribe-panel settings   protocol, censorship, LAN, split tunneling
    windscribe-panel toggle     connect, or disconnect after asking

For a panel that draws its own UI (the Omarchy shell front end), a JSON API.
Every call prints {"ok": true, ...} or {"ok": false, "error": "..."}:

    status | catalog | pings [--force] | connect [best|<nickname>] | disconnect
    set <Key> <value> | preset <name> | domain add|remove <hostname> | refresh-ranges [CC]

It runs unprivileged, only ever calls windscribe-cli with fixed arguments, and
edits windscribe_cli.conf atomically under the same lock as the range refresher.
"""
from concurrent.futures import ThreadPoolExecutor
import configparser
import html
from datetime import datetime, timezone
import fcntl
import ipaddress
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request

HERE = Path(__file__).resolve().parent.parent
CONFIG = Path(os.environ.get('WINDSCRIBE_CONFIG', Path.home() / '.config/Windscribe/windscribe_cli.conf'))
STATE = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'windscribe-panel/country-ranges.json'
CLI = os.environ.get('WINDSCRIBE_CLI', 'windscribe-cli')
REFRESHER = HERE / 'bin/windscribe-split-refresh'
LEGACY_STATE = STATE.parent.parent / 'omarchy-windscribe/country-ranges.json'
STATE_DIR = STATE.parent
SERVERLIST_URL = 'https://assets.windscribe.com/serverlist/mob-v2/1/1'
SERVERLIST_TTL = 6 * 3600
PING_TTL = 15 * 60
CONFIG_LOCK = CONFIG.parent / '.windscribe-panel.lock'
# XDG_RUNTIME_DIR, else our own state folder: never a world-writable /tmp,
# where another user could plant a symlink for the lock to write through.
CLI_LOCK = (Path(os.environ['XDG_RUNTIME_DIR']) if os.path.isdir(os.environ.get('XDG_RUNTIME_DIR', '')) else STATE.parent) / 'windscribe-panel-cli.lock'

BOOLS = {'Autoconnect', 'AllowLANTraffic', 'CircumventCensorship', 'SplitTunnelingEnabled'}
PROTOCOLS = ['WireGuard', 'Stealth', 'WStunnel', 'UDP', 'TCP']
READ_KEYS = BOOLS | {'AmneziawgPreset', 'ConnectionMode', 'ManualConnectionProtocol', 'ManualConnectionPort',
                     'ConnectedDNSMode', 'FirewallMode', 'SplitTunnelingMode'}
MAX_HOSTNAMES = 50
ANSI = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')


def cli(*args, timeout=10):
    # The CLI talks to one daemon; concurrent calls from a poll and a click garble each other.
    CLI_LOCK.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with CLI_LOCK.open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            proc = subprocess.run([CLI, *args], capture_output=True, text=True, timeout=timeout)
        except FileNotFoundError:
            raise RuntimeError('windscribe-cli is not installed. Run bin/setup, or see the README.') from None
        except subprocess.TimeoutExpired:
            raise RuntimeError('Windscribe did not answer in %ds. Is windscribe.service running?' % timeout) from None
    out = ANSI.sub('', proc.stdout).strip()
    if proc.returncode:
        raise RuntimeError((out or ANSI.sub('', proc.stderr).strip() or 'windscribe-cli failed')[:400])
    return out


def parse_status(text):
    fields = {}
    for line in text.splitlines():
        if ': ' in line:
            key, value = line.lstrip('* ').split(': ', 1)
            fields[key.strip()] = value.strip()
    connection = fields.get('Connect state', '')
    firewall = fields.get('Firewall state', 'Unknown')
    lowered = connection.lower()
    if fields.get('Login state', '').lower().startswith('logged out'):
        state = 'signedOut'
    elif connection.startswith('Connected'):
        # A leading star marks a tunnel that is up but still being verified.
        state = 'testing' if re.search(r'^\*\s*Connect state', text, re.MULTILINE) else 'connected'
    elif any(word in lowered for word in ('connecting', 'reconnecting', 'disconnecting')):
        state = 'connecting'
    elif connection.startswith('Disconnected'):
        state = 'blocked' if firewall in ('On', 'Always On') else 'disconnected'
    else:
        state = 'unknown'
    location = connection.split(':', 1)[1].strip() if state in ('connected', 'testing') and ':' in connection else ''
    city, _, nickname = location.partition(' - ')
    return {
        'state': state,
        'location': location,
        'city': city,
        'nickname': nickname,
        'firewall': firewall,
        'ip': fields.get('VPN IP', ''),
        'protocol': fields.get('Protocol', ''),
        'login': fields.get('Login state', ''),
        'internet': fields.get('Internet connectivity', ''),
        'usage': fields.get('Data usage', ''),
    }


def parse_locations(text):
    """`Region - City - Nickname (10 Gbps)` rows; the nickname is what `connect` takes."""
    result = []
    for line in text.splitlines():
        line = line.strip()
        speed = re.search(r'\(([^)]*)\)\s*$', line)
        label = line[:speed.start()].strip() if speed else line
        parts = [p.strip() for p in label.split(' - ')]
        if len(parts) < 3:
            continue
        result.append({'id': parts[-1], 'city': parts[-2], 'region': ' - '.join(parts[:-2]),
                       'speed': speed.group(1) if speed else ''})
    result.sort(key=lambda row: (row['region'], row['city'], row['id']))
    return result


def server_details(serverlist):
    """nickname -> link speed, load and the address Windscribe itself pings,
    from the public server list the Windscribe apps download."""
    details = {}
    for region in serverlist.get('data', []):
        for group in region.get('groups', []):
            nick = group.get('nick')
            if not nick:
                continue
            try:
                link = int(group.get('link_speed') or 0)
            except ValueError:
                link = 0
            details[nick] = {'link': link, 'load': group.get('health'), 'pingIp': group.get('ping_ip') or ''}
    return details


def cached_json(path, ttl, fetch):
    """The JSON at `path` if younger than `ttl`, else `fetch()` saved there.
    A failed fetch falls back to a stale copy, then to None."""
    try:
        if time.time() - path.stat().st_mtime < ttl:
            return json.loads(path.read_text())
    except (OSError, ValueError):
        pass
    try:
        data = fetch()
    except Exception:
        try:
            return json.loads(path.read_text())
        except (OSError, ValueError):
            return None
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix('.tmp')
    tmp.write_text(json.dumps(data))
    tmp.replace(path)
    return data


def fetch_serverlist():
    with urllib.request.urlopen(SERVERLIST_URL, timeout=15) as response:
        return json.loads(response.read(8_000_000))


def ping_once(address):
    """Round trip in ms to one server, or None. ICMP needs no privileges on Arch."""
    try:
        ipaddress.ip_address(address)
    except ValueError:
        return None
    try:
        out = subprocess.run(['ping', '-n', '-q', '-c', '2', '-i', '0.2', '-W', '1', address],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    match = re.search(r'= [\d.]+/([\d.]+)/', out)
    return round(float(match.group(1))) if match else None


def measure_pings(targets, tunnel):
    with ThreadPoolExecutor(max_workers=48) as pool:
        results = dict(zip(targets, pool.map(ping_once, targets.values())))
    return {'pings': {nick: ms for nick, ms in results.items() if ms is not None},
            'measured': datetime.now(timezone.utc).isoformat(timespec='seconds'), 'tunnel': tunnel}


def pings(force=False):
    """Latency per location. Through the VPN every probe also crosses the
    tunnel, which hides the real distance, so a measurement taken while
    disconnected is kept for a day and preferred over a fresh tunnelled one."""
    path = STATE_DIR / 'pings.json'
    try:
        cache = json.loads(path.read_text())
        age = time.time() - datetime.fromisoformat(cache['measured']).timestamp()
    except (OSError, ValueError, KeyError):
        cache, age = None, float('inf')
    tunnel = parse_status(cli('status'))['state'] in ('connected', 'testing', 'connecting')
    if cache and not force:
        if age < PING_TTL or (tunnel and not cache.get('tunnel') and age < 86400):
            return cache
    details = server_details(cached_json(STATE_DIR / 'serverlist.json', SERVERLIST_TTL, fetch_serverlist) or {})
    targets = {nick: d['pingIp'] for nick, d in details.items() if d['pingIp']}
    if not targets:
        raise RuntimeError('Could not load the Windscribe server list to ping.')
    result = measure_pings(targets, tunnel)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(result))
    return result


def hostname(value):
    value = value.strip().lower().rstrip('.')
    if value.startswith(('http://', 'https://')):
        raise ValueError('Enter just the hostname, without http:// or a path.')
    if not value or any(c.isspace() or c in '/:*' for c in value):
        raise ValueError('Enter a hostname like app.example.ir. Wildcards and paths are not supported.')
    if is_network(value):
        raise ValueError('That is an IP address. Country ranges are managed for you.')
    try:
        value = value.encode('idna').decode('ascii')
    except UnicodeError:
        raise ValueError('That hostname is not valid.') from None
    labels = value.split('.')
    if len(value) > 253 or len(labels) < 2 or not all(
            re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', label) for label in labels):
        raise ValueError('Enter a hostname like app.example.ir.')
    return value


def is_network(value):
    try:
        ipaddress.ip_network(value)
        return True
    except ValueError:
        return False


def change_domains(routes, action, value):
    value = hostname(value)
    if action == 'remove':
        return [r for r in routes if r != value]
    if action != 'add':
        raise ValueError('Unknown hostname action')
    if value in routes:
        return routes
    if sum(not is_network(r) for r in routes) >= MAX_HOSTNAMES:
        raise ValueError('Windscribe allows %d hostnames. Remove one first.' % MAX_HOSTNAMES)
    return routes + [value]


def setting_changes(key, value):
    if key in BOOLS and value in ('true', 'false'):
        return {key: value}
    if key == 'SplitTunnelingMode' and value in ('Exclude', 'Include'):
        return {key: value}
    if key == 'ConnectionMode' and value == 'Auto':
        return {'ConnectionMode': 'Auto'}
    if key == 'ManualConnectionProtocol' and value in PROTOCOLS:
        # 443 is open for every Windscribe protocol, and the least likely to be filtered.
        return {'ConnectionMode': 'Manual', key: value, 'ManualConnectionPort': '443'}
    raise ValueError('Unsupported setting: %s=%s' % (key, value))


def read_config():
    try:
        return CONFIG.read_text()
    except FileNotFoundError:
        raise RuntimeError('No Windscribe settings yet: run windscribe-cli status once (or bin/setup).') from None


def read_preferences(text):
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str
    parser.read_string(text)
    if not parser.has_section('Connection'):
        raise ValueError('The Windscribe config has no [Connection] section. Run windscribe-cli once first.')
    section = parser['Connection']
    routes = [s.strip() for s in section.get('SplitTunnelingRoutes', '').split(',') if s.strip()]
    prefs: dict = {key: section.get(key, '') for key in READ_KEYS}
    prefs['domains'] = [r for r in routes if not is_network(r)]
    prefs['rangeCount'] = len(routes) - len(prefs['domains'])
    return prefs, routes


def edit_ini(text, changes):
    """Rewrite keys inside [Connection] in place, keeping every other byte as it was."""
    lines = text.splitlines(keepends=True)
    start = next((i for i, line in enumerate(lines) if line.strip() == '[Connection]'), None)
    if start is None:
        raise ValueError('The Windscribe config has no [Connection] section')
    end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith('[')), len(lines))
    pending = dict(changes)
    for i in range(start + 1, end):
        key = lines[i].split('=', 1)[0].strip()
        if key in pending:
            lines[i] = key + '=' + pending.pop(key) + '\n'
    if pending:
        if end and not lines[end - 1].endswith('\n'):
            lines[end - 1] += '\n'
        lines[end:end] = [key + '=' + value + '\n' for key, value in pending.items()]
    return ''.join(lines)


def mutate(make_changes):
    with CONFIG_LOCK.open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        original = read_config()
        prefs, routes = read_preferences(original)
        changed = edit_ini(original, make_changes(prefs, routes))
        if changed == original:
            return
        fd, name = tempfile.mkstemp(prefix='.windscribe-panel-', dir=CONFIG.parent)
        try:
            with os.fdopen(fd, 'w') as stream:
                stream.write(changed)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(name, CONFIG.stat().st_mode & 0o777)
            os.replace(name, CONFIG)
        finally:
            if os.path.exists(name):
                os.unlink(name)


def bypass_state():
    for path in (STATE, LEGACY_STATE):
        try:
            state = json.loads(path.read_text())
            return {'country': state.get('country', ''), 'updated': state.get('updated', '')}
        except (OSError, ValueError):
            continue
    return {'country': '', 'updated': ''}


def dispatch(args):
    if args == ['status']:
        prefs, _ = read_preferences(read_config())
        return {'status': parse_status(cli('status')), 'settings': prefs, 'bypass': bypass_state()}
    if args == ['catalog']:
        locations = parse_locations(cli('locations'))
        details = server_details(cached_json(STATE_DIR / 'serverlist.json', SERVERLIST_TTL, fetch_serverlist) or {})
        for row in locations:
            extra = details.get(row['id'], {})
            row['link'] = extra.get('link', 0)
            row['load'] = extra.get('load')
        return {'locations': locations,
                'presets': [p for p in cli('amneziawg').splitlines() if p.strip()]}
    if args in (['pings'], ['pings', '--force']):
        return pings(force=len(args) == 2)
    if args == ['connect']:
        cli('connect', '-n')
        return {'message': 'Connecting to your last location…'}
    if len(args) == 2 and args[0] == 'connect':
        target = args[1]
        if target != 'best' and target not in {r['id'] for r in parse_locations(cli('locations'))}:
            raise ValueError('Choose a location from the current Windscribe list.')
        cli('connect', '-n', target)
        return {'message': 'Connecting to %s…' % ('the best location' if target == 'best' else target)}
    if args == ['disconnect']:
        cli('disconnect', '-n')
        return {'message': 'Disconnected.'}
    if len(args) == 3 and args[0] == 'set':
        changes = setting_changes(args[1], args[2])
        mutate(lambda p, r: changes)
        return {'message': 'Saved.'}
    if len(args) == 2 and args[0] == 'preset':
        if args[1] not in cli('amneziawg').splitlines():
            raise ValueError('Choose one of the listed censorship presets.')
        mutate(lambda p, r: {'AmneziawgPreset': args[1]})
        return {'message': 'Preset saved.'}
    if len(args) == 3 and args[0] == 'domain':
        mutate(lambda p, r: {'SplitTunnelingRoutes': ', '.join(change_domains(r, args[1], args[2]))})
        return {'message': ('Added ' if args[1] == 'add' else 'Removed ') + hostname(args[2]) + '.'}
    if args and args[0] == 'refresh-ranges' and len(args) <= 2:
        proc = subprocess.run([sys.executable, str(REFRESHER), *args[1:]], capture_output=True, text=True, timeout=90)
        if proc.returncode:
            raise RuntimeError((proc.stderr or proc.stdout).strip()[-400:])
        return {'message': proc.stdout.strip()}
    raise ValueError('Unknown operation: ' + ' '.join(args))


# ---- Bar and launcher front end. Menus go through whichever dmenu-style
#      launcher is installed, so the same commands work under any compositor.

SIGNAL = int(os.environ.get('WINDSCRIBE_PANEL_SIGNAL', '8'))
LAUNCHERS = [
    ['fuzzel', '--dmenu', '--width', '66', '--lines', '15', '--prompt'],
    ['wofi', '--dmenu', '--prompt'],
    ['rofi', '-dmenu', '-i', '-p'],
    ['tofi', '--require-match=false', '--prompt-text'],
    ['bemenu', '-i', '-p'],
]
LABELS = {
    'connected': 'Connected', 'connecting': 'Connecting…', 'off': 'Off, traffic blocked by the firewall',
    'unprotected': 'Off, traffic is NOT protected', 'signedOut': 'Signed out', 'unknown': 'Unavailable',
}


def bar_state(status):
    """One name per look: connected, connecting, off, unprotected, signedOut, unknown."""
    return {'testing': 'connecting', 'blocked': 'off', 'disconnected': 'unprotected'}.get(status['state'], status['state'])


def waybar():
    try:
        status = parse_status(cli('status'))
        prefs, _ = read_preferences(read_config())
    except Exception as error:
        return {'text': '', 'alt': 'unknown', 'class': 'unknown',
                'tooltip': '<b>Windscribe</b>\n' + html.escape(str(error))}
    state = bar_state(status)
    rows = [('Location', status['location']), ('VPN IP', status['ip']), ('Protocol', status['protocol']),
            ('Firewall', status['firewall']), ('Data', status['usage'].split(' / ')[0])]
    if prefs['SplitTunnelingEnabled'] == 'true':
        bypass = bypass_state()
        rows.append(('Bypass', '%s · %d ranges · %d hosts' % (bypass['country'] or '--', prefs['rangeCount'], len(prefs['domains']))))
    lines = ['<b>Windscribe</b>  %s' % html.escape(LABELS[state])]
    # The label column is monospace so the values line up in any tooltip font.
    lines += ['<tt><span alpha="60%%">%-9s</span></tt> %s' % (k, html.escape(v)) for k, v in rows if v]
    lines.append('<span alpha="60%">click: locations · right: settings · middle: on/off</span>')
    return {'text': html.escape(status['city']) if state == 'connected' else '', 'alt': state, 'class': state,
            'tooltip': '\n'.join(lines)}


def notify(body, urgent=False):
    if shutil.which('notify-send'):
        subprocess.run(['notify-send', '-a', 'Windscribe', '-u', 'critical' if urgent else 'normal',
                        'Windscribe', body], check=False)
    else:
        print(body, file=sys.stderr)


def refresh_bar():
    subprocess.run(['pkill', '-RTMIN+%d' % SIGNAL, 'waybar'], check=False, capture_output=True)


def choose(prompt, entries):
    """The line picked in the launcher, or None when dismissed."""
    custom = os.environ.get('WINDSCRIBE_PANEL_MENU', '').strip()
    if custom:
        command = shlex.split(custom)
        # A command ending in its prompt flag (rofi's -p, fuzzel's --prompt) gets the prompt.
        if command[-1].startswith('-'):
            command.append(prompt + ' ')
    else:
        found = next((l for l in LAUNCHERS if shutil.which(l[0])), None)
        if not found:
            raise RuntimeError('No menu launcher found: install fuzzel, wofi, rofi, tofi or bemenu, '
                               'or set WINDSCRIBE_PANEL_MENU to a dmenu-style command.')
        command = found + [prompt + ' ']
    proc = subprocess.run(command, input='\n'.join(entries), capture_output=True, text=True)
    # Exit 1 is how dmenu-style launchers report Escape; anything else is a fault.
    if proc.returncode not in (0, 1):
        raise RuntimeError('%s failed: %s' % (command[0], (proc.stderr or 'exit %d' % proc.returncode).strip()[:200]))
    picked = proc.stdout.strip()
    return picked if proc.returncode == 0 and picked else None


def pick(prompt, actions):
    """actions: [(label, callable)]; runs the chosen one."""
    labels = [label for label, _ in actions]
    picked = choose(prompt, labels)
    if picked is None:
        return None
    # Launchers trim differently, and labels carry alignment padding.
    for label, action in actions:
        if label.strip() == picked.strip():
            return action()
    return None


def act(args):
    result = dispatch(args)
    refresh_bar()
    if result.get('message'):
        notify(result['message'])


def location_menu():
    status = parse_status(cli('status'))
    if not os.path.exists(STATE_DIR / 'pings.json'):
        notify('Measuring ping to every location, a few seconds…')
    try:
        measured = pings()
    except RuntimeError:  # server list unreachable: region order, no times
        measured = {}
    latency = measured.get('pings', {})
    rows = dispatch(['catalog'])['locations']
    rows.sort(key=lambda r: (latency.get(r['id']) is None, latency.get(r['id'], 0), r['region'], r['city']))
    actions = [('      Best location', lambda: act(['connect', 'best']))]
    for row in rows:
        ms = latency.get(row['id'])
        here = status['nickname'] == row['id'] and bar_state(status) == 'connected'
        speed = '%dG' % (row['link'] // 1000) if row['link'] >= 1000 else ('%dM' % row['link'] if row['link'] else '')
        detail = ' '.join(x for x in (speed, '' if row['load'] is None else '%s%%' % row['load']) if x)
        label = '%s %6s  %-28s %-13s %s' % ('●' if here else ' ', '%d ms' % ms if ms is not None else '--',
                                            row['city'] + ' · ' + row['id'], row['region'], detail)
        actions.append((label, lambda r=row: act(['connect', r['id']])))
    prompt = 'Location (pings via tunnel)' if measured.get('tunnel') else 'Location'
    pick(prompt, actions)


def toggle():
    status = parse_status(cli('status'))
    if status['state'] == 'signedOut':
        return notify('Signed out. Run windscribe-cli login in a terminal.', urgent=True)
    if bar_state(status) not in ('connected', 'connecting'):
        return act(['connect'])
    firewall = status['firewall'] in ('On', 'Always On')
    warning = ('Disconnect: the firewall blocks the internet until you reconnect' if firewall
               else 'Disconnect: traffic will go out WITHOUT the VPN')
    pick('Disconnect?', [(warning, lambda: act(['disconnect'])), ('Stay connected', lambda: None)])


def settings_menu():
    prefs, _ = read_preferences(read_config())
    status = parse_status(cli('status'))
    on = lambda key: prefs.get(key) == 'true'
    flip = lambda key: (lambda: act(['set', key, 'false' if on(key) else 'true']))
    word = lambda key: 'on' if on(key) else 'off'
    protocol = 'Auto' if prefs['ConnectionMode'] == 'Auto' else prefs['ManualConnectionProtocol']
    country = os.environ.get('WINDSCRIBE_BYPASS_COUNTRY') or bypass_state()['country'] or 'IR'

    def protocols():
        options = [('Auto', lambda: act(['set', 'ConnectionMode', 'Auto']))]
        options += [(p, lambda p=p: act(['set', 'ManualConnectionProtocol', p])) for p in PROTOCOLS]
        pick('Protocol', options)

    def presets():
        names = [n for n in cli('amneziawg').splitlines() if n.strip()]
        pick('AmneziaWG preset', [(n, lambda n=n: act(['preset', n])) for n in names])

    def add_host():
        name = choose('Hostname to bypass', [])
        if name:
            act(['domain', 'add', name])

    def remove_host():
        pick('Remove hostname', [(d, lambda d=d: act(['domain', 'remove', d])) for d in prefs['domains']])

    tunnel = bar_state(status) in ('connected', 'connecting')
    pick('Windscribe', [
        ('Disconnect…' if tunnel else 'Connect to last location', toggle),
        ('Protocol: %s ›' % protocol, protocols),
        ('Auto-connect: %s' % word('Autoconnect'), flip('Autoconnect')),
        ('Circumvent censorship: %s' % word('CircumventCensorship'), flip('CircumventCensorship')),
        ('AmneziaWG preset: %s ›' % (prefs['AmneziawgPreset'] or 'none'), presets),
        ('Allow LAN traffic: %s' % word('AllowLANTraffic'), flip('AllowLANTraffic')),
        ('Split tunneling: %s (%s · %d ranges · %d hosts)' % (word('SplitTunnelingEnabled'), country,
                                                             prefs['rangeCount'], len(prefs['domains'])),
         flip('SplitTunnelingEnabled')),
        ('Refresh %s ranges now' % country, lambda: (notify('Fetching %s ranges…' % country), act(['refresh-ranges', country]))),
        ('Add a hostname to bypass…', add_host),
        ('Remove a hostname ›', remove_host),
    ])


FRONT_END = {'menu': location_menu, 'settings': settings_menu, 'toggle': toggle}


def main():
    args = sys.argv[1:]
    if args == ['waybar']:
        print(json.dumps(waybar()))
        return
    if len(args) == 1 and args[0] in FRONT_END:
        try:
            FRONT_END[args[0]]()
        except Exception as error:
            notify(str(error)[:300], urgent=True)
            sys.exit(1)
        return
    if not args or args[0] in ('-h', '--help', 'help'):
        print(__doc__.strip())
        return
    try:
        print(json.dumps({'ok': True, **dispatch(args)}))
    except Exception as error:
        print(json.dumps({'ok': False, 'error': str(error)[:400]}))
        sys.exit(1)


if __name__ == '__main__':
    main()
