#!/bin/bash

# Set Windscribe up for the Omarchy panel, or take the setup back out.
#
#   bin/setup               # bypass Iran (IR)
#   bin/setup DE            # bypass another country
#   bin/setup --update-cli  # also upgrade windscribe-cli to the latest release
#   bin/setup --uninstall   # remove the weekly refresh; Windscribe is left as it is
#
# Safe to run again: every step checks before it changes anything.

set -euo pipefail

HERE=$(cd "$(dirname "$0")/.." && pwd)
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
NAME=omarchy-windscribe-refresh
CONFIG="$HOME/.config/Windscribe/windscribe_cli.conf"

step() { printf '\033[1m==>\033[0m %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

update_cli=0
country=IR
for arg in "$@"; do
  case $arg in
  --uninstall) uninstall=1 ;;
  --update-cli) update_cli=1 ;;
  -*) die "unknown option: $arg" ;;
  *) country=$arg ;;
  esac
done

# The official Arch package, from Windscribe's own GitHub releases, checked
# against the sha256 GitHub records for the upload.
install_cli() {
  local release name url digest tmp
  release=$(curl -fsSL https://api.github.com/repos/Windscribe/Desktop-App/releases/latest) \
    || die "could not reach GitHub to download windscribe-cli"
  name=$(jq -r '.assets[] | select(.name | test("^windscribe-cli_.*_amd64\\.pkg\\.tar\\.zst$")) | .name' <<<"$release" | head -1)
  url=$(jq -r --arg n "$name" '.assets[] | select(.name == $n) | .browser_download_url' <<<"$release")
  digest=$(jq -r --arg n "$name" '.assets[] | select(.name == $n) | .digest // ""' <<<"$release")
  [[ -n $name && -n $url ]] || die "no Arch package in the latest Windscribe release"
  [[ $(uname -m) == x86_64 ]] || die "Windscribe only publishes x86_64 Arch packages"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' RETURN
  note "Downloading $name"
  curl -fL --progress-bar -o "$tmp/$name" "$url"
  if [[ $digest == sha256:* ]]; then
    echo "${digest#sha256:}  $tmp/$name" | sha256sum -c --quiet - || die "checksum mismatch for $name"
  else
    note "GitHub has no checksum for this upload; installing on HTTPS trust alone"
  fi
  sudo pacman -U --needed --noconfirm "$tmp/$name"
}

if [[ ${uninstall:-0} == 1 ]]; then
  step "Removing the weekly range refresh"
  systemctl --user disable --now "$NAME.timer" 2>/dev/null || true
  rm -f "$UNITS/$NAME.service" "$UNITS/$NAME.timer"
  systemctl --user daemon-reload
  note "Done. Your Windscribe settings and route list were not changed."
  exit 0
fi

country=$(tr '[:lower:]' '[:upper:]' <<<"$country")
[[ $country =~ ^[A-Z]{2}$ ]] || die "country must be a two-letter ISO code, like IR"

step "Checking dependencies"
missing=()
for pair in python3:python ping:iputils jq:jq curl:curl; do
  command -v "${pair%%:*}" >/dev/null || missing+=("${pair#*:}")
done
((${#missing[@]} == 0)) || sudo pacman -S --needed --noconfirm "${missing[@]}"
if pacman -Q windscribe >/dev/null 2>&1; then
  note "The Windscribe GUI package is installed; it ships windscribe-cli too"
elif ! command -v windscribe-cli >/dev/null || ((update_cli)); then
  step "Installing windscribe-cli"
  install_cli
fi
command -v windscribe-cli >/dev/null || die "windscribe-cli is still missing"
note "$(windscribe-cli --help 2>/dev/null | head -1)"

step "Starting the Windscribe services"
systemctl is-active --quiet windscribe-helper.service || sudo systemctl enable --now windscribe-helper.service
systemctl --user enable --now windscribe.service >/dev/null 2>&1 || note "windscribe.service could not be started; is the helper installed?"
for _ in {1..10}; do [[ -f $CONFIG ]] && break; sleep 1; done
[[ -f $CONFIG ]] || die "$CONFIG did not appear. Run windscribe-cli status once, then try again."

if windscribe-cli status 2>/dev/null | grep 'Logged out' >/dev/null; then
  step "Signing in"
  windscribe-cli login
fi

step "Turning split tunneling on, in Exclude mode"
python3 "$HERE/backend.py" set SplitTunnelingMode Exclude >/dev/null
python3 "$HERE/backend.py" set SplitTunnelingEnabled true >/dev/null

step "Fetching $country's network ranges"
python3 "$HERE/bin/windscribe-split-refresh" "$country"

step "Installing a weekly refresh ($NAME.timer)"
mkdir -p "$UNITS"
cat >"$UNITS/$NAME.service" <<UNIT
[Unit]
Description=Refresh $country network ranges in the Windscribe split tunnel
After=network-online.target windscribe.service
ConditionPathExists=$CONFIG

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 $HERE/bin/windscribe-split-refresh $country
TimeoutStartSec=120
UMask=0077
UNIT
cat >"$UNITS/$NAME.timer" <<UNIT
[Unit]
Description=Weekly refresh of $country ranges for the Windscribe split tunnel

[Timer]
OnCalendar=weekly
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT
systemctl --user daemon-reload
systemctl --user enable --now "$NAME.timer" >/dev/null
note "Next run: $(systemctl --user show "$NAME.timer" -p NextElapseUSecRealtime --value)"

if [[ $country != IR ]]; then
  note "Tell the panel too: add \"bypassCountry\": \"$country\" to its entry in ~/.config/omarchy/shell.json"
fi
step "Done"
