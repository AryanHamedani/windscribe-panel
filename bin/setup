#!/bin/bash

# Set Windscribe up for the bar, or take the setup back out. Works on any
# systemd distribution with pacman, apt, dnf or zypper.
#
#   bin/setup               # bypass Iran (IR)
#   bin/setup DE            # bypass another country
#   bin/setup --update-cli  # also upgrade windscribe-cli to the latest release
#   bin/setup --uninstall   # remove the weekly refresh; Windscribe is left as it is
#
# Safe to run again: every step checks before it changes anything.

set -euo pipefail

HERE=$(cd "$(dirname "$0")/.." && pwd)
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
NAME=windscribe-split-refresh
# Tailscale's ranges go to its routing table (52) ahead of Windscribe's rules
# (5208/5209), then nowhere: an address that is not a live peer, or any of them
# while tailscaled is stopped, hits "unreachable" instead of leaving by the router.
TS_DROPIN=/etc/systemd/system/tailscaled.service.d/50-windscribe-panel.conf
TS_RULES=(
  "to 100.64.0.0/10 lookup 52 priority 5200"
  "to 100.64.0.0/10 unreachable priority 5201"
  "-6 to fd7a:115c:a1e0::/48 lookup 52 priority 5200"
  "-6 to fd7a:115c:a1e0::/48 unreachable priority 5201"
)
# "ip [-6] rule add|del|show RULE"; the family flag has to come before "rule",
# and show only filters on the address and priority, not the action.
ip_rule() {
  local verb=$1 r=$2 fam=""
  [[ $r == -6* ]] && { fam=-6; r=${r#-6 }; }
  [[ $verb == show ]] && { r=${r/lookup 52 /}; r=${r/unreachable /}; }
  echo "ip $fam rule $verb $r"
}
CONFIG="$HOME/.config/Windscribe/windscribe_cli.conf"

step() { printf '\033[1m==>\033[0m %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

update_cli=0
country=IR
for arg in "$@"; do
  case $arg in
  --uninstall) uninstall=1 ;;
  --update-cli) update_cli=1 ;;
  -*) die "unknown option: $arg" ;;
  *) country=$arg ;;
  esac
done

if command -v pacman >/dev/null; then pm=pacman
elif command -v apt-get >/dev/null; then pm=apt
elif command -v dnf >/dev/null; then pm=dnf
elif command -v zypper >/dev/null; then pm=zypper
else pm=""; fi

apt_ready=0
apt_update() { ((apt_ready)) || { sudo apt-get update; apt_ready=1; }; }

pkg_install() {
  case $pm in
  pacman) sudo pacman -S --needed --noconfirm "$@" ;;
  apt) apt_update && sudo apt-get install -y "$@" ;;
  dnf) sudo dnf install -y "$@" ;;
  zypper) sudo zypper -n install "$@" ;;
  *) die "install these yourself, then run this again: $*" ;;
  esac
}

# Package names differ only for python and ping.
dep_package() {
  case $1:$pm in
  python3:pacman) echo python ;;
  python3:*) echo python3 ;;
  ping:apt) echo iputils-ping ;;
  ping:*) echo iputils ;;
  *) echo "$1" ;;
  esac
}

# The official package for this system, from Windscribe's own GitHub
# releases, checked against the sha256 GitHub records for the upload.
install_cli() {
  local release name url digest tmp arch pattern
  case $(uname -m) in
  x86_64) arch=amd64 ;;
  aarch64) arch=arm64 ;;
  *) die "Windscribe publishes packages for x86_64 and aarch64 only" ;;
  esac
  case $pm in
  pacman) pattern="_${arch}\\.pkg\\.tar\\.zst$" ;;
  apt) pattern="_${arch}\\.deb$" ;;
  dnf) pattern="_${arch}_fedora\\.rpm$" ;;
  zypper) pattern="_${arch}_opensuse\\.rpm$" ;;
  *) die "install windscribe-cli from https://windscribe.com/download, then run this again" ;;
  esac
  release=$(curl -fsSL https://api.github.com/repos/Windscribe/Desktop-App/releases/latest) \
    || die "could not reach GitHub to download windscribe-cli"
  name=$(jq -r --arg p "^windscribe-cli_.*$pattern" '.assets[] | select(.name | test($p)) | .name' <<<"$release" | head -1)
  url=$(jq -r --arg n "$name" '.assets[] | select(.name == $n) | .browser_download_url' <<<"$release")
  digest=$(jq -r --arg n "$name" '.assets[] | select(.name == $n) | .digest // ""' <<<"$release")
  [[ -n $name && -n $url ]] || die "the latest Windscribe release has no $pm package for $arch"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' RETURN
  note "Downloading $name"
  curl -fL --progress-bar -o "$tmp/$name" "$url"
  if [[ $digest == sha256:* ]]; then
    echo "${digest#sha256:}  $tmp/$name" | sha256sum -c --quiet - || die "checksum mismatch for $name"
  else
    note "GitHub has no checksum for this upload; installing on HTTPS trust alone"
  fi
  case $pm in
  pacman) sudo pacman -U --needed --noconfirm "$tmp/$name" ;;
  apt) apt_update && sudo apt-get install -y "$tmp/$name" ;;
  dnf) sudo dnf install -y "$tmp/$name" ;;
  zypper) sudo zypper -n install --allow-unsigned-rpm "$tmp/$name" ;;
  esac
}

if [[ ${uninstall:-0} == 1 ]]; then
  step "Removing the weekly range refresh"
  systemctl --user disable --now "$NAME.timer" 2>/dev/null || true
  rm -f "$UNITS/$NAME.service" "$UNITS/$NAME.timer"
  systemctl --user daemon-reload
  if [[ -e $TS_DROPIN ]]; then
    step "Removing the Tailscale routing rules and route-list entries"
    python3 "$HERE/bin/windscribe-split-refresh" --drop-tailscale || true
    sudo rm -f "$TS_DROPIN"
    sudo systemctl daemon-reload
    for r in "${TS_RULES[@]}"; do sudo $(ip_rule del "$r") 2>/dev/null || true; done
  fi
  note "Done. Your Windscribe settings and route list were not changed."
  exit 0
fi

country=$(tr '[:lower:]' '[:upper:]' <<<"$country")
[[ $country =~ ^[A-Z]{2}$ ]] || die "country must be a two-letter ISO code, like IR"

step "Checking dependencies"
missing=()
for cmd in python3 ping jq curl; do
  command -v "$cmd" >/dev/null || missing+=("$(dep_package "$cmd")")
done
((${#missing[@]} == 0)) || pkg_install "${missing[@]}"
# The Windscribe GUI package ships windscribe-cli too, so either one will do.
if ! command -v windscribe-cli >/dev/null || ((update_cli)); then
  step "Installing windscribe-cli"
  install_cli
fi
command -v windscribe-cli >/dev/null || die "windscribe-cli is still missing"
note "$(windscribe-cli --help 2>/dev/null | head -1)"

step "Starting the Windscribe services"
systemctl is-active --quiet windscribe-helper.service || sudo systemctl enable --now windscribe-helper.service
systemctl --user enable --now windscribe.service >/dev/null 2>&1 || note "windscribe.service could not be started; is the helper installed?"
for _ in {1..10}; do [[ -f $CONFIG ]] && break; sleep 1; done
[[ -f $CONFIG ]] || die "$CONFIG did not appear. Run windscribe-cli status once, then try again."

if windscribe-cli status 2>/dev/null | grep 'Logged out' >/dev/null; then
  step "Signing in"
  # Under `curl … | bash` stdin is the script, so the prompt reads the terminal.
  if [[ -r /dev/tty ]]; then
    windscribe-cli login </dev/tty
  else
    note "No terminal to sign in from: run windscribe-cli login, then this again"
  fi
fi

step "Turning split tunneling on, in Exclude mode"
python3 "$HERE/bin/windscribe-panel" set SplitTunnelingMode Exclude >/dev/null
python3 "$HERE/bin/windscribe-panel" set SplitTunnelingEnabled true >/dev/null

if command -v tailscale >/dev/null && systemctl is-enabled --quiet tailscaled 2>/dev/null; then
  # The refresh below keeps Tailscale's ranges out of the tunnel, which opens
  # the Windscribe firewall to them; these rules send them to tailscale0 or
  # nowhere. They stay when tailscaled stops, so the ranges never fail open.
  step "Letting Tailscale work while Windscribe and its firewall are on"
  {
    echo '# Added by windscribe-panel (bin/setup). See its README, "Tailscale".'
    echo '# "-": a rule that is already there is not an error.'
    echo '[Service]'
    for r in "${TS_RULES[@]}"; do echo "ExecStartPost=-$(ip_rule add "$r")"; done
  } | sudo install -D -m 644 /dev/stdin "$TS_DROPIN"
  sudo systemctl daemon-reload
  # Apply now as well, without restarting tailscaled.
  for r in "${TS_RULES[@]}"; do
    $(ip_rule show "$r") | grep -q . || sudo $(ip_rule add "$r")
  done
fi

step "Fetching $country's network ranges"
python3 "$HERE/bin/windscribe-split-refresh" "$country"

step "Installing a weekly refresh ($NAME.timer)"
# 1.1 and earlier named it after Omarchy; take that one out first.
systemctl --user disable --now omarchy-windscribe-refresh.timer >/dev/null 2>&1 || true
rm -f "$UNITS/omarchy-windscribe-refresh.service" "$UNITS/omarchy-windscribe-refresh.timer"
mkdir -p "$UNITS"
cat >"$UNITS/$NAME.service" <<UNIT
[Unit]
Description=Refresh $country network ranges in the Windscribe split tunnel
After=network-online.target windscribe.service
ConditionPathExists=$CONFIG

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 $HERE/bin/windscribe-split-refresh $country
TimeoutStartSec=120
UMask=0077
UNIT
cat >"$UNITS/$NAME.timer" <<UNIT
[Unit]
Description=Weekly refresh of $country ranges for the Windscribe split tunnel

[Timer]
OnCalendar=weekly
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT
systemctl --user daemon-reload
systemctl --user enable --now "$NAME.timer" >/dev/null
note "Next run: $(systemctl --user show "$NAME.timer" -p NextElapseUSecRealtime --value)"

if [[ $country != IR ]]; then
  note "Both front ends now refresh $country by default."
fi
step "Done"
