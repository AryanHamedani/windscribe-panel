#!/usr/bin/env python3
"""Keep one country's networks outside the Windscribe tunnel.

Fetches the country's allocated IPv4 and IPv6 ranges from RIPEstat, checks
them, and writes them into Windscribe's split-tunnel route list. Hostnames and
IP ranges you added yourself are kept. Nothing else in the config is touched,
and the Windscribe CLI reloads the file on its own as soon as it changes.

    windscribe-split-refresh            # Iran, the default
    windscribe-split-refresh DE         # any ISO 3166 country code
    windscribe-split-refresh --dry-run  # fetch and validate, write nothing
"""
import argparse
from datetime import datetime, timezone
import fcntl
import ipaddress
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request

CONFIG = Path(os.environ.get('WINDSCRIBE_CONFIG', Path.home() / '.config/Windscribe/windscribe_cli.conf'))
STATE = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'windscribe-panel/country-ranges.json'
# Where 1.1 and earlier kept it, read until the next refresh writes the new one.
LEGACY_STATE = STATE.parent.parent / 'omarchy-windscribe/country-ranges.json'
LOCK = CONFIG.parent / '.windscribe-panel.lock'
URL = 'https://stat.ripe.net/data/country-resource-list/data.json?resource={}&v4_format=prefix'
# Windscribe 2.24 refuses route lists past this size.
ROUTE_CAPACITY = 4096
MAX_HOSTNAMES = 50
# Tailscale's address ranges. While tailscaled is enabled they stay outside the
# tunnel, or the Windscribe firewall drops tailnet traffic. bin/setup routes
# them to Tailscale's table, or nowhere, so they never leave by the router.
TAILSCALE_RANGES = ['100.64.0.0/10', 'fd7a:115c:a1e0::/48']


def validated_ranges(payload):
    """The collapsed networks in a RIPEstat answer, or ValueError if it looks wrong."""
    if payload.get('status') != 'ok':
        raise ValueError('RIPEstat did not return a successful result')
    resources = payload['data']['resources']
    result = []
    for family, version, shortest in (('ipv4', 4, 8), ('ipv6', 6, 16)):
        networks = []
        for value in resources.get(family, []):
            network = ipaddress.ip_network(value)
            # A /0 or a private block here means the answer is not what we asked for.
            if network.version != version or not network.is_global or network.prefixlen < shortest:
                raise ValueError('Unsafe network in the country list: ' + value)
            networks.append(network)
        result.extend(str(n) for n in ipaddress.collapse_addresses(networks))
    if not result:
        raise ValueError('RIPEstat returned no networks for this country')
    return result


def is_network(value):
    try:
        ipaddress.ip_network(value)
        return True
    except ValueError:
        return False


def merge_routes(current, fresh, previous, always=(), previous_always=()):
    """Country ranges first, then the ranges in `always`, then whatever the
    user added: hostnames, and IP ranges that were not part of the last
    country list or `always` set we wrote. Without a record of that list,
    every IP range is assumed to be ours."""
    managed = set(previous) if previous is not None else {r for r in current if is_network(r)}
    managed |= set(previous_always)
    always = [r for r in always if r not in fresh]
    keep = [r for r in current if r not in managed and r not in fresh and r not in always]
    for entry in keep:
        if not is_network(entry) and not re.fullmatch(r'[A-Za-z0-9.-]+', entry):
            raise ValueError('Unsupported entry in the route list: ' + entry)
    if sum(not is_network(r) for r in keep) > MAX_HOSTNAMES:
        raise ValueError('More than %d hostname exceptions' % MAX_HOSTNAMES)
    routes = fresh + always + keep
    if len(routes) > ROUTE_CAPACITY:
        raise ValueError("%d routes exceed Windscribe's limit of %d" % (len(routes), ROUTE_CAPACITY))
    return routes


def read_routes(config):
    matches = re.findall(r'^SplitTunnelingRoutes=(.*)$', config, re.MULTILINE)
    if len(matches) != 1:
        raise ValueError('Expected exactly one SplitTunnelingRoutes line in ' + str(CONFIG))
    return [r.strip() for r in matches[0].split(',') if r.strip()]


def write_routes(config, routes):
    return re.sub(r'^SplitTunnelingRoutes=.*$', lambda _: 'SplitTunnelingRoutes=' + ', '.join(routes),
                  config, count=1, flags=re.MULTILINE)


def atomic_write(path, content, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(name, mode)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def load_state():
    for path in (STATE, LEGACY_STATE):
        try:
            return json.loads(path.read_text())
        except (OSError, ValueError):
            continue
    return {}


def fetch(country):
    with urllib.request.urlopen(URL.format(country), timeout=45) as response:
        data = response.read(4_000_001)
    if len(data) > 4_000_000:
        raise ValueError('Oversized RIPEstat response')
    return json.loads(data)


def tailscale_enabled():
    if not shutil.which('tailscale'):
        return False
    return subprocess.run(['systemctl', 'is-enabled', '--quiet', 'tailscaled'],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def drop_tailscale():
    """Take Tailscale's ranges out of the route list (bin/setup --uninstall)."""
    with LOCK.open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        original = CONFIG.read_text()
        updated = write_routes(original, [r for r in read_routes(original) if r not in TAILSCALE_RANGES])
        if updated != original:
            atomic_write(CONFIG.with_name(CONFIG.name + '.bak'), original)
            atomic_write(CONFIG, updated)
        state = load_state()
        if state.get('always'):
            state['always'] = []
            atomic_write(STATE, json.dumps(state))
        return 'Tailscale ranges %s' % ('removed' if updated != original else 'were not in the list')


def refresh(country, dry_run=False):
    fresh = validated_ranges(fetch(country))
    with LOCK.open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        original = CONFIG.read_text()
        state = load_state()
        always = TAILSCALE_RANGES if tailscale_enabled() else []
        routes = merge_routes(read_routes(original), fresh, state.get('ranges'), always, state.get('always', ()))
        updated = write_routes(original, routes)
        if dry_run:
            return '%s: %d ranges would be written (dry run)' % (country, len(fresh))
        if updated != original:
            atomic_write(CONFIG.with_name(CONFIG.name + '.bak'), original)
            atomic_write(CONFIG, updated)
        atomic_write(STATE, json.dumps({'country': country, 'ranges': fresh, 'always': always,
                                        'updated': datetime.now(timezone.utc).isoformat(timespec='seconds')}))
        return '%s: %d ranges %s' % (country, len(fresh), 'updated' if updated != original else 'unchanged')


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('country', nargs='?', default=os.environ.get('WINDSCRIBE_BYPASS_COUNTRY', 'IR'))
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--drop-tailscale', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    country = args.country.upper()
    if not re.fullmatch(r'[A-Z]{2}', country):
        parser.error('country must be a two-letter ISO code, like IR')
    try:
        print(drop_tailscale() if args.drop_tailscale else refresh(country, args.dry_run))
    except Exception as error:  # one line for the panel and the journal
        print('windscribe-split-refresh: %s' % error, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
